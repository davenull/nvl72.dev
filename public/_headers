# Applies to static asset responses only (not to Worker-generated responses).
# Max 100 rules, 2000 chars per line.
#
# Note: COOP/COEP are deliberately NOT set. They are only required for
# SharedArrayBuffer (multithreaded WASM decoding), which this site does not use
# — the rack geometry is generated procedurally in JS, so there is no Draco or
# Basis decoder to thread. Adding them would complicate any future embed.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Astro emits content-hashed filenames under /_astro, so these are immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
